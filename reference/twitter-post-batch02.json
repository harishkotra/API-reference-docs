{
  "openapi": "3.0.3",
  "info": {
    "title": "Twitter API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.aisa.one/apis/v1"
    }
  ],
  "paths": {
    "/twitter/retweet_v3": {
      "post": {
        "tags": [
          "twitterapi-retweet"
        ],
        "summary": "Retweet a Tweet",
        "operationId": "retweetTweet",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "tweet_id",
                  "user_name"
                ],
                "properties": {
                  "user_name": {
                    "type": "string",
                    "description": "Twitter username. Must be set. The user must have been logged in via user_login_v3."
                  },
                  "tweet_id": {
                    "type": "string",
                    "description": "The id of the tweet to retweet. Must be set."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "description": "Status of the request. success or error"
                    },
                    "msg": {
                      "type": "string",
                      "description": "Message of the request. error message"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/twitter/delete_tweet_v2": {},
    "/twitter/follow_user_v2": {},
    "/twitter/unfollow_user_v2": {},
    "/twitter/like_tweet_v3": {
      "post": {
        "tags": [
          "twitterapi-like"
        ],
        "summary": "Like a Tweet",
        "operationId": "likeTweet",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "tweet_id",
                  "user_name"
                ],
                "properties": {
                  "user_name": {
                    "type": "string",
                    "description": "Twitter username. Must be set. The user must have been logged in via user_login_v3."
                  },
                  "tweet_id": {
                    "type": "string",
                    "description": "The id of the tweet to retweet. Must be set."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "description": "Status of the request. success or error"
                    },
                    "msg": {
                      "type": "string",
                      "description": "Message of the request. error message"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}